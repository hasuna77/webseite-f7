# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# ".env" wird nie committet (siehe .gitignore).

# --- Website (Auth) ---
# Zufälliger, langer String zum Signieren der Login-Session.
# Generieren z.B. mit: openssl rand -hex 32
# Ohne gesetzten Wert erzeugt die App automatisch ein lokales Dev-Secret
# unter .data/auth-secret.key – für Produktion bitte explizit setzen.
AUTH_SECRET=

# --- KI-Chat-Support-Widget & Automatisierungs-Agents ---
# Erforderlich für den Chat-Assistenten auf der Website UND für
# agents/content-agent, agents/posting-agent, agents/seo-agent.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Modelle überschreiben (Standard: claude-sonnet-5-5)
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
ANTHROPIC_CONTENT_MODEL=claude-sonnet-5-5

# --- Posting-Agent: Facebook & Instagram (Meta Graph API) ---
# Meta for Developers -> App -> Seite verbinden -> langlebiges
# Seiten-Zugriffstoken generieren.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# Mit der Facebook-Seite verknüpftes Instagram-Business-Konto (nötig für
# Instagram-Posts; Instagram verlangt zusätzlich immer ein Bild).
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Posting-Agent: LinkedIn (Unternehmensseite) ---
# LinkedIn Developer Portal -> App -> OAuth2-Token mit
# w_organization_social-Scope.
LINKEDIN_ACCESS_TOKEN=
# Format: urn:li:organization:12345678
LINKEDIN_ORG_URN=

# --- SEO-Agent ---
# Standard-URL, die geprüft wird, wenn --url nicht übergeben wird.
SITE_URL=https://www.f7studio.de
